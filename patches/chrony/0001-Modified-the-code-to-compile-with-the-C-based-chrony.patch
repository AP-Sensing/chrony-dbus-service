-static void
-bits_to_mask(int bits, int family, IPAddr *mask)
-{
-  int i;
-
-  mask->family = family;
-  switch (family) {
-    case IPADDR_INET4:
-      if (bits > 32 || bits < 0)
-        bits = 32;
-      if (bits > 0) {
-        mask->addr.in4 = -1;
-        mask->addr.in4 <<= 32 - bits;
-      } else {
-        mask->addr.in4 = 0;
-      }
-      break;
-    case IPADDR_INET6:
-      if (bits > 128 || bits < 0)
-        bits = 128;
-      for (i = 0; i < bits / 8; i++)
-        mask->addr.in6[i] = 0xff;
-      if (i < 16)
-        mask->addr.in6[i++] = (0xff << (8 - bits % 8)) & 0xff;
-      for (; i < 16; i++)
-        mask->addr.in6[i] = 0x0;
-      break;
-    case IPADDR_ID:
-      mask->family = IPADDR_UNSPEC;
-      break;
-    default:
-      assert(0);
-  }
-}
