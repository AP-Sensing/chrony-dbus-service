diff --git a/include/chrony/logging.hpp b/include/chrony/logging.hpp
new file mode 100644
index 0000000..2064811
--- /dev/null
+++ b/include/chrony/logging.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <iostream>
+#include <utility>
+
+namespace logging
+{
+inline bool debugLoggingIsEnabled = false;
+
+template<typename... Args>
+void logTo(std::ostream& output, Args&&... args)
+{
+    (output << ... << std::forward<Args>(args));
+    output << '\n';
+}
+
+template<typename... Args>
+void debugLog(Args&&... args)
+{
+    if (debugLoggingIsEnabled)
+    {
+        logTo(std::cout, std::forward<Args>(args)...);
+    }
+}
+
+template<typename... Args>
+void errorLog(Args&&... args)
+{
+    logTo(std::cerr, std::forward<Args>(args)...);
+}
+}  // namespace logging
