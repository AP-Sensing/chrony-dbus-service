From e93afd60642a7b6f031dbf5270c8923e05935208 Mon Sep 17 00:00:00 2001
From: John Fletcher <john.fletcher@apsensing.com>
Date: Wed, 14 Oct 2026 21:22:57 +0000
Subject: [PATCH 4/4] Adjust logging

---
 include/chrony/client.hpp | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/include/chrony/client.hpp b/include/chrony/client.hpp
index 3ec83b8..a385b30 100644
--- a/include/chrony/client.hpp
+++ b/include/chrony/client.hpp
@@ -328,7 +328,7 @@ submit_request(CMD_Request *request, CMD_Reply *reply)
     if (::chrony::util::UTI_CompareTimespecs(&ts_now, &ts_start) < 0) ts_start = ts_now;
 
     timeout = initial_timeout / 1000.0 * (1U << (n_attempts - 1)) - ::chrony::util::UTI_DiffTimespecsToDouble(&ts_now, &ts_start);
-    logging::errorLog("submit_request(): Timeout ", timeout, " seconds");
+    logging::debugLog("submit_request(): Timeout ", timeout, " seconds");
 
     /* Avoid calling select() with an invalid timeout */
     if (timeout <= 0.0)
@@ -407,8 +407,7 @@ submit_request(CMD_Request *request, CMD_Reply *reply)
         }
 
         /* Good packet received, print out results */
-        logging::errorLog("Reply cmd=", ntohs(reply->command), " reply=", ntohs(reply->command), " stat=", ntohs(reply->status)
-                 );
+        logging::debugLog("Reply cmd=", ntohs(reply->command), " reply=", ntohs(reply->command), " stat=", ntohs(reply->status));
         break;
       }
     }
